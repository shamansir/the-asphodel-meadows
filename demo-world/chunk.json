      "emits": [
        { "id": "evt.fold_deduction", "weight": 0.8,
          "text": "The foil's crease is doubled and off-centre: it lay on two eyes and was folded to pass as one coin. Coins on the eyes is a recent custom, not the old rite of the mouth — so the foil came off a newer grave than the fare it replaced. Only whoever carries the newly dead's effects down could have taken it.",
          "witnesses": ["ch.holmes", "ch.persephone"] },
        { "id": "evt.persephone_first", "weight": 0.35,
          "text": "Persephone had reached the same conclusion before Holmes and said nothing until he got there.",
          "witnesses": ["ch.holmes", "ch.persephone"] }
      ]
    },

